{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm test)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm migrate:lint)",
      "Bash(pnpm tsx scripts/check-agent-config.ts)",
      "Bash(pnpm tsx scripts/*)",
      "Bash(pnpm -r run *)",
      "Bash(pnpm -r --parallel run *)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git status -s)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git diff --cached)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline -*)",
      "Bash(git log -*)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(ls *)",
      "Bash(wc -l *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -fr *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Read(./node_modules/**)",
      "Edit(./node_modules/**)",
      "Write(./node_modules/**)",
      "Bash(rm * .env*)",
      "Bash(rm * node_modules*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "description": "Local filesystem access scoped to the workspace. Anthropic reference server."
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."],
      "description": "Git operations beyond bash: parsed log, structured diff. Used by the lifter and reconciler."
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "description": "Issue tracking and PR operations. Optional in early phases; load-bearing in Phase 6.",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "_intentgraph_notes": {
    "future_mcp_servers": "When IntentGraph's own MCP server ships in Phase 3, register it here as `intentgraph` with command pointing at packages/skill/dist/index.js over stdio.",
    "agent_runner_chokepoint": "ESLint enforces packages/skill/src/agent-runner as the only path to model calls. See eslint.config.mjs."
  }
}
