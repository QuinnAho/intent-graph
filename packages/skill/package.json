    "drizzle-orm": "^0.36.4",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.0",
    "inngest": "^3.27.0",
    "sqlite-vec": "^0.1.6",
    "tree-sitter": "^0.21.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
