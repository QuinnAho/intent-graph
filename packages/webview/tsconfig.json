{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "src/**/*.tsx"],
  "exclude": ["dist", "tests"],
  "references": [{ "path": "../shared" }]
}
